{
  "name": "sadovnikov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest",
    "test:unit": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:db:up": "docker compose -f compose.test.yaml up -d",
    "test:db:down": "docker compose -f compose.test.yaml down -v",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:db:seed": "dotenv -e .env.test -- prisma db seed",
    "test:lighthouse": "lhci autorun",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:server && pnpm test:integration && pnpm build && pnpm test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react-datepicker": "^7.0.0",
    "better-auth": "^1.6.23",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "gigachat": "^0.0.20",
    "jsdom": "^30.0.1",
    "next": "^16.2.4",
    "next-intl": "^4.13.2",
    "nodemailer": "^9.0.3",
    "react": "^19.2.5",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "swiper": "^12.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.4.0",
    "msw": "^2.15.0",
    "prisma": "^6.19.3",
    "sass": "^1.99.0",
    "sass-embedded": "^1.98.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
