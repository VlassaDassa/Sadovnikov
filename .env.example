# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/database_name

# Authentication
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
AUTH_BOOTSTRAP=false # When you need to create a user, set to true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password # Only for first create admin, after may delete

# Umami Analytics
UMAMI_USERNAME=admin
UMAMI_PASSWORD=your_password
UMAMI_URL=https://analytics.yourdomain.com
UMAMI_WEBSITE_ID=your_website_id
ANALYTICS_TIMEZONE=Europe/Moscow

# GitHub API (for Evolution feature)
GITHUB_TOKEN=github_pat_your_token_here
EVOLUTION_MAX_COMMITS=300

# GigaChat AI (for Evolution feature)
GIGACHAT_EVOLUTION_MODEL=GigaChat-2-Max
GIGACHAT_TIMEOUT_SECONDS=120
GIGACHAT_MAX_OUTPUT_TOKENS=3500
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CREDENTIALS=your_base64_credentials
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Yandex SMTP (for contact form)
YANDEX_SMTP_USER=your_email@yandex.ru
YANDEX_SMTP_PASSWORD=your_app_password
CONTACT_EMAIL_TO=your_email@yandex.ru

# Local file uploads
UPLOAD_ROOT=./.uploads/portfolio
UPLOAD_PUBLIC_PREFIX=/uploads/portfolio
UPLOAD_MAX_IMAGE_BYTES=8388608

VITE_CONFIG_NATIVE_IGNORE_WARNING=true